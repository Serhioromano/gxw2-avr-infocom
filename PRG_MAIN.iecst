(* fbAmBlock(iProcessNum := 1, iSeverity := AM_ERROR, Q := gxIsAlarm); *)
fbAmalarm(
    iProcessNum := 0,
    iSeverity := 0,
    Q := gxIsAlarm
);

(* Предполагается, что при исправном общем питании на X13 высокий уровень. M8002
   принудительно выполняет сброс в первом цикле после перехода в RUN, даже если X13 уже активен. *)
xDrivePower := DI_Avarkontrol AND NOT M8002;
(* Нормально замкнутые контакты положения дают TRUE при отключённом выключателе. *)
xAllOff := DI_Line1IsOff AND DI_Line2IsOff AND DI_GeneratorIsOff;
(* В каждом цикле ПЛК отслеживать передние фронты ручных команд включения. Команда,
   поданная во время запрета, не запоминается: после снятия запрета нужно нажать кнопку снова. *)
xManualOn1 := MEP(gxOn1);
xManualOn2 := MEP(gxOn2);
xManualOnGen := MEP(gxOnGenerator);

IF xAutoWasOn <> gxAvto THEN
    IF NOT gxAvto THEN
        (* Переход из автоматического режима в ручной: взять фактические положения, а не ожидающие команды.
           Для включённого выключателя сохранить запрос на включённое положение, даже если автоматика запрашивала отключение.
           Для отключённого выключателя оставить запрос снятым, отменив ожидающие попытки включения. *)
        xSetOn1 := NOT DI_Line1IsOff;
        xSetOn2 := NOT DI_Line2IsOff;
        xSetOnGen := NOT DI_GeneratorIsOff;
    ELSE
        (* При переходе в автоматический режим перед выбором источника отменить невыполненные ручные запросы на включение. *)
        xSetOn1 := xSetOn1 AND NOT DI_Line1IsOff;
        xSetOn2 := xSetOn2 AND NOT DI_Line2IsOff;
        xSetOnGen := xSetOnGen AND NOT DI_GeneratorIsOff;
    END_IF;
    IF iStep <> 0 THEN
        iStep := 10; (* Вернуться к ручному управлению или выбору источника, а не к шагу прежнего источника. *)
    END_IF;
END_IF;

(* Источник доступен, только если реле контроля фаз и аппаратный вход контроля аварии
   показывают норму, а у выключателя нет зафиксированной тревоги или неисправности. *)
M1 := DI_RKF1 AND DI_Avar1 AND NOT VVALine1.xError AND NOT gxProblemVVA1;
M2 := DI_RKF2 AND DI_Avar2 AND NOT VVALine2.xError AND NOT gxProblemVVA2;
M3 := DI_RKF3 AND DI_AvarGenerator AND NOT VVAGen.xError AND NOT gxProblemVVAgen;

OUT_T(M1, TC1, SEC_TO_TIMER100(clTimeRKF1));
OUT_T(M2, TC2, SEC_TO_TIMER100(clTimeRKF2));
OUT_T(M3, TC3, SEC_TO_TIMER100(clTimeRKF3));

(* TC30 отсчитывает время при наличии сигнала исправности питания приводов: 100 × 100 мс = 10 с.
   Пропадание сигнала X13 сбрасывает таймер. Во время ожидания на шаге 0 все прежние запросы снимаются. *)
OUT_T(xDrivePower, TC30, K100);
IF NOT xDrivePower OR NOT TS30 THEN
    iStep := 0;
END_IF;

(* Перед новым автоматическим запросом на включение выдержать паузу: все три сигнала
   отключённого положения должны непрерывно оставаться активными, а запросов на включение быть не должно.
   После отмены запроса не переносить отсчитанное время на другой источник. Номинальная выдержка при K11 — 1,1 с. *)
OUT_T(
    gxAvto
    AND xDrivePower
    AND xAllOff
    AND NOT (xSetOn1 OR xSetOn2 OR xSetOnGen),
    TC32,
    K11
);

(* Возврат в автоматический режим
OUT_T(gxVVAOff, TC31, SEC_TO_TIMER100(clTimeBackAuto));
IF TS31 THEN
	gxVVAOff := FALSE;
END_IF;
 *)

CASE iStep OF
    0: (* Ожидание питания приводов, взвода пружин и отключённого положения выключателей. *)
        xGenerator := FALSE;
        gxStartGenerator := FALSE;
        xSetOn1 := FALSE;
        xSetOn2 := FALSE;
        xSetOnGen := FALSE;
        (* Выйти из пускового шага только после выдержки времени, когда все три выключателя отключены. *)
        MOV(
            xDrivePower
            AND TS30
            AND xAllOff,
            10,
            iStep
        );

    10: (* Ожидание или ручное управление. *)
        IF gxAvto THEN
            iStep := 20;
            gxStartGenerator := FALSE;
        ELSIF NOT xAutoWasOn AND NOT M2002 AND xAllOff AND NOT (xSetOn1 OR xSetOn2 OR xSetOnGen) THEN
            (* В предыдущем цикле должен быть ручной режим. Не должно быть квитирования
               или действующего запроса; все выключатели должны быть отключены. Цепочка ELSIF
               принимает не более одного запроса на включение: сначала ввод 1, затем ввод 2, затем генератор. *)
            IF xManualOn1 AND M1 AND NOT gxOff1 THEN
                xSetOn1 := TRUE;
            ELSIF xManualOn2 AND M2 AND NOT gxOff2 THEN
                xSetOn2 := TRUE;
            ELSIF xManualOnGen AND M3 AND NOT gxOffGenerator THEN
                xSetOnGen := TRUE;
            END_IF;
        END_IF;
        IF NOT gxAvto THEN
            (* Команда отключения, потеря готовности источника или включение другого выключателя
               отменяют соответствующий ручной запрос и его повторные попытки. *)
            RST(
                gxOff1
                OR NOT DI_Line2IsOff
                OR NOT DI_GeneratorIsOff
                OR NOT M1,
                xSetOn1
            );
            RST(
                gxOff2
                OR NOT DI_Line1IsOff
                OR NOT DI_GeneratorIsOff
                OR NOT M2,
                xSetOn2
            );
            RST(
                gxOffGenerator
                OR NOT DI_Line1IsOff
                OR NOT DI_Line2IsOff
                OR NOT M3,
                xSetOnGen
            );
        END_IF;
        xGenerator := gxStartGenerator;

    20: (* Выбрать первый доступный источник после выдержки времени по сигналу реле контроля фаз. *)
        MOV(TS1, 30, iStep);
        MOV(
            TS2
            AND NOT TS1,
            40,
            iStep
        );
        MOV(
            NOT TS1
            AND NOT TS2
            AND TS3,
            50,
            iStep
        );
        (* Сохранить запрос на включение только для выбранного источника, остальные снять. *)
        xSetOn1 := xSetOn1 AND iStep = 30;
        xSetOn2 := xSetOn2 AND iStep = 40;
        xSetOnGen := xSetOnGen AND iStep = 50;
        xGenerator := NOT TS1 AND NOT TS2;

    30: (* Ввод 1. Такая же блокировка действует на шагах 40 и 50. *)
        (* Снять запросы на включение двух других выключателей, чтобы их блоки могли подать команды отключения. *)
        xSetOn2 := FALSE;
        xSetOnGen := FALSE;
        MOV(
            NOT TS1 (* Ввод 1 больше не готов. *)
            OR NOT M1, (* Ввод 1 больше не удовлетворяет условиям доступности, проверяемым без задержки. *)
            10,
            iStep
        );
        (* Выдерживать паузу только перед новым запросом. Сохранять действующий запрос,
           когда его выключатель включается и сбрасывает TC32 или когда VVA ещё выполняет повторные попытки. *)
        xSetOn1 := DI_GeneratorIsOff
            AND DI_Line2IsOff
            AND iStep = 30
            AND (xSetOn1 OR (xAllOff AND TS32));

    40: (* Ввод 2: перед запросом на включение дождаться отключения выключателей ввода 1 и генератора. *)
        xSetOn1 := FALSE;
        xSetOnGen := FALSE;
        MOV(
            NOT TS2 (* Ввод 2 больше не готов. *)
            OR NOT M2, (* Ввод 2 больше не удовлетворяет условиям доступности, проверяемым без задержки. *)
            10,
            iStep
        );
        xSetOn2 := DI_GeneratorIsOff
            AND DI_Line1IsOff
            AND iStep = 40
            AND (xSetOn2 OR (xAllOff AND TS32));

    50: (* Генератор: дождаться отключения выключателей обоих сетевых вводов. Вернуться к выбору источника,
           если один из сетевых вводов снова готов или генератор больше недоступен. *)
        xSetOn2 := FALSE;
        xSetOn1 := FALSE;
        MOV(
            NOT TS3 (* Готовность по напряжению генератора больше не подтверждается. *)
            OR NOT M3 (* Генератор больше не удовлетворяет условиям доступности, проверяемым без задержки. *)
            OR TS1 OR TS2, (* Готов хотя бы один сетевой ввод. *)
            10,
            iStep
        );
        xGenerator := TRUE;
        xSetOnGen := DI_Line1IsOff
            AND DI_Line2IsOff
            AND iStep = 50
            AND (xSetOnGen OR (xAllOff AND TS32));
ELSE (* Недопустимый номер шага: снять запросы и вернуться к пусковому шагу. *)
    iStep := 0;
    xSetOn1 := FALSE;
    xSetOn2 := FALSE;
    xSetOnGen := FALSE;
END_CASE;
xAutoWasOn := gxAvto; (* Запомнить режим, чтобы обнаружить его смену в следующем цикле ПЛК. *)

fbTPStartGen(
    IN := xGenerator,
    PT := SEC_TO_TIME(clTimeGenerator)
);
DO_StartGenerator := NOT (xGenerator OR fbTPStartGen.Q);

(* Вызывать блок каждого выключателя в каждом цикле, в том числе при пуске, чтобы таймеры
   и выходы обновлялись даже без запроса на включение. Для IsOn инвертировать сигнал отключённого положения. *)
VVALine1(
    SetOn := xSetOn1,
    IsOn := NOT DI_Line1IsOff,
    xDrivePower := xDrivePower,
    ResetAlarm := M2002,
    Vkl := DO_On1,
    Otkl := DO_Off1
);
VVALine2(
    SetOn := xSetOn2,
    IsOn := NOT DI_Line2IsOff,
    xDrivePower := xDrivePower,
    ResetAlarm := M2002,
    Vkl := DO_On2,
    Otkl := DO_Off2
);
VVAGen(
    SetOn := xSetOnGen,
    IsOn := NOT DI_GeneratorIsOff,
    xDrivePower := xDrivePower,
    ResetAlarm := M2002,
    Vkl := DO_OnGenerator,
    Otkl := DO_OffGenerator
);

(* В ручном режиме сбросить переключатель «Вкл.» на панели оператора только при отключённом выключателе:
   если нет действующего запроса или блок только что сообщил об исчерпании попыток включения.
   Не сбрасывать переключатель в паузах между попытками и после успешного включения. *)
IF NOT gxAvto THEN
    RST(
        DI_Line1IsOff
        AND (NOT xSetOn1 OR VVALine1.xVklFailed),
        gxOn1
    );
    RST(
        DI_Line2IsOff
        AND (NOT xSetOn2 OR VVALine2.xVklFailed),
        gxOn2
    );
    RST(
        DI_GeneratorIsOff
        AND (NOT xSetOnGen OR VVAGen.xVklFailed),
        gxOnGenerator
    );
END_IF;

(* Зафиксировать исчерпание попыток включения или неожиданное отключение. Со следующего цикла
   проверка доступности исключает этот выключатель, пока неисправность не будет сброшена. *)
SET(
    VVALine1.xVklFailed
    OR VVALine1.xUnexpectedOff,
    gxProblemVVA1
);
SET(
    VVALine2.xVklFailed
    OR VVALine2.xUnexpectedOff,
    gxProblemVVA2
);
SET(
    VVAGen.xVklFailed
    OR VVAGen.xUnexpectedOff,
    gxProblemVVAgen
);
SET(
    gxProblemVVA1
    OR gxProblemVVA2
    OR gxProblemVVAgen,
    gxVVAOff
);