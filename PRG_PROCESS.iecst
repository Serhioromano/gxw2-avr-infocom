fbAmReset(IN := M2002);

IF M2002 THEN
	gxProblemVVA1 := FALSE;
	gxProblemVVA2 := FALSE;
	gxProblemVVAgen := FALSE;
END_IF;

PortSettings := MB_PORT_SETTINGS(MB_PARITY_NONE, MB_STOPBIT_1, MB_BPS_38400);
xMBInit := MB_SLAVE_INIT_PORT2(TRUE, 20, PortSettings);

(* Тревоги *)
OUT_T(NOT DI_Avarkontrol, TC24, 10);
fbAmSet(iNum := 0, xState := TS24);
OUT_T(NOT DI_Avar1 OR gxProblemVVA1, TC21, 5);
fbAmSet(iNum := 1, xState := TS21);
OUT_T(NOT DI_Avar2 OR gxProblemVVA2, TC22, 5);
fbAmSet(iNum := 2, xState := TS22);
OUT_T(NOT DI_AvarGenerator OR gxProblemVVAgen, TC23, 5);
fbAmSet(iNum := 3, xState := TS23);
fbAmSet(iNum := 4, xState := FALSE);
OUT_T(DO_On1 AND DI_Line1IsOff, TC11, 10);
fbAmSet(iNum := 5, xState := TS11);
OUT_T(DO_Off1 AND NOT DI_Line1IsOff, TC12, 10);
fbAmSet(iNum := 6, xState := TS12);
OUT_T(DO_On2 AND DI_Line2IsOff, TC13, 10);
fbAmSet(iNum := 7, xState := TS13);
OUT_T(DO_Off2 AND NOT DI_Line2IsOff, TC14, 10);
fbAmSet(iNum := 8, xState := TS14);
OUT_T(DO_Ongenerator AND DI_GeneratorIsOff, TC15, 10);
fbAmSet(iNum := 9, xState := TS15);
OUT_T(DO_OffGenerator AND NOT DI_GeneratorIsOff, TC16, 10);
fbAmSet(iNum := 10, xState := TS16);
OUT_T(DO_OnSection AND DI_SectionIsOff , TC17, 10);
fbAmSet(iNum := 1, xState := TS17);
OUT_T(DO_OffSection AND NOT DI_SectionIsOff, TC18, 10);
fbAmSet(iNum := 12, xState := TS18);
OUT_T(NOT DO_StartGenerator AND NOT DI_RKF3, TC19, SEC_TO_TIMER100(clStartgenerator));
fbAmSet(iNum := 13, xState := TS19);

xNodata := (
	clStartgenerator = 0
	OR clTimeGenerator = 0
	OR clTimeRKF1 = 0
	OR clTimeRKF2 = 0
	OR clTimeRKF3 = 0
);
fbAmSet(iNum := 14, xState := xNodata);

fbAMEvents(EventNum := 0, EventState := DI_RKF1);
fbAMEvents(EventNum := 1, EventState := NOT DI_RKF1);
fbAMEvents(EventNum := 2, EventState := DI_RKF2);
fbAMEvents(EventNum := 3, EventState := NOT DI_RKF2);
fbAMEvents(EventNum := 4, EventState := DI_RKF3);
fbAMEvents(EventNum := 5, EventState := NOT DI_RKF3);
fbAMEvents(EventNum := 6, EventState := DO_On1);
fbAMEvents(EventNum := 7, EventState := DO_Off1);
fbAMEvents(EventNum := 8, EventState := DO_On2);
fbAMEvents(EventNum := 9, EventState := DO_Off2);
fbAMEvents(EventNum := 10, EventState := DO_Ongenerator);
fbAMEvents(EventNum := 11, EventState := DO_Offgenerator);
fbAMEvents(EventNum := 12, EventState := DO_OnSection);
fbAMEvents(EventNum := 13, EventState := DO_OffSection);
fbAMEvents(EventNum := 14, EventState := NOT DO_StartGenerator);
fbAMEvents(EventNum := 15, EventState := DO_StartGenerator);
fbAMEvents(EventNum := 16, EventState := gxAvto);
fbAMEvents(EventNum := 17, EventState := NOT gxAvto);
fbAMEvents(EventNum := 18, EventState := TS1);
fbAMEvents(EventNum := 19, EventState := TS2);
fbAMEvents(EventNum := 20, EventState := TS3);

(*
fbTOFResetProblems(IN:= MEP(gxProblemVVA1) OR MEP(gxProblemVVA2) OR MEP(gxProblemVVAgen), PT:= SEC_TO_TIME(1800));
IF M2002 OR fbTOFResetProblems.Q THEN
	gxProblemVVA1 := FALSE;
	gxProblemVVA2 := FALSE;
	gxProblemVVAgen := FALSE;
END_IF;
 *)
